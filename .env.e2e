# Browser tests (Playwright, `make e2e`). Tracked on purpose, like .env.testing: a throwaway key and the
# local docker database. Its OWN database (nxtgen_e2e, wiped every run) and port, so a run never touches
# your working data — E2EServiceProvider refuses to start against anything not named *_e2e.
APP_NAME=NxtGen
APP_ENV=e2e
APP_KEY=base64:Czve0RY8UK1EiQqxQSwl/s2Z0mbzhi2oQrydoGhsq/c=
APP_DEBUG=true
APP_URL=http://127.0.0.1:3021

LOG_CHANNEL=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=33316
DB_DATABASE=nxtgen_e2e
DB_USERNAME=nxtgen
DB_PASSWORD=nxtgen

# In the e2e database, so every run starts with empty sessions and rate limits (no Redis needed).
SESSION_DRIVER=database
SESSION_LIFETIME=600
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Emails are written to the log AND copied to storage/app/e2e/mailbox.jsonl (E2EServiceProvider).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@nxtgen.test"
MAIL_FROM_NAME="${APP_NAME}"
BROADCAST_CONNECTION=null

# Three browsers on one machine are one "device" to the app's per-IP limits (20/min in production).
# Per-EMAIL limits stay as in production — each journey uses its own fresh address.
RATE_LIMIT_PER_DEVICE_PER_MINUTE=1000
