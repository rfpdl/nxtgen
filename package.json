{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "lint": "eslint resources/js tests/e2e playwright.config.ts",
        "lint:fix": "eslint resources/js tests/e2e playwright.config.ts --fix",
        "format": "prettier --write --no-error-on-unmatched-pattern \"resources/js/**/*.{ts,vue}\" \"tests/e2e/**/*.ts\"",
        "format:check": "prettier --check --no-error-on-unmatched-pattern \"resources/js/**/*.{ts,vue}\" \"tests/e2e/**/*.ts\"",
        "typecheck": "vue-tsc --noEmit",
        "discipline": "vitest run resources/js/tests/component-discipline.test.ts"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.4.1",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vitest/coverage-v8": "^4.1.11",
        "@vue/test-utils": "^2.5.0",
        "axios": "^1.11.0",
        "concurrently": "^10.0.5",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.0",
        "glob": "^13.0.6",
        "globals": "^17.12.0",
        "happy-dom": "^20.14.0",
        "laravel-vite-plugin": "^3.2.0",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.69.0",
        "vite": "^8.2.2",
        "vitest": "^4.1.11",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.11"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@inertiajs/vue3": "^3.7.0",
        "@lucide/vue": "^1.42.0",
        "@vueuse/core": "^14.4.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-vue-next": "^1.0.0",
        "pinia": "^4.0.3",
        "reka-ui": "^2.10.4",
        "tailwind-merge": "^3.6.0",
        "vue": "^3.5.42",
        "ziggy-js": "^2.6.4"
    },
    "name": "nxtgen"
}
