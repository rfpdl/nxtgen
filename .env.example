APP_NAME="NxtGen"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3020

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MySQL 8.4 from docker-compose.yml (port 33316 so it can run beside the PoC on 33306).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=33316
DB_DATABASE=nxtgen
DB_USERNAME=nxtgen
DB_PASSWORD=nxtgen

# Sessions in Redis: migrate:fresh no longer signs everyone out, and it is what Laravel Cloud runs.
SESSION_DRIVER=redis
SESSION_LIFETIME=600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=36389

# Emails (magic links) go to storage/logs/laravel.log. For Mailpit: `docker compose --profile mail up -d`
# then MAIL_MAILER=smtp and open http://localhost:8026.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1026
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@nxtgen.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# The church `php artisan db:seed` creates in PRODUCTION (ChurchSeeder). Locally, db:seed makes the demo church.
# Satellite names must match the registry sheet's "Home satellite" spelling. The first admin signs in by
# email link and adds everyone else on People.
NXTGEN_CHURCH_SLUG=ccf
NXTGEN_CHURCH_NAME=CCF
NXTGEN_CHURCH_TIMEZONE=Asia/Dubai
NXTGEN_SATELLITES="CCF Dxb"
NXTGEN_FIRST_ADMIN_EMAIL=
NXTGEN_FIRST_ADMIN_NAME="Church Admin"

# Per-device (IP) limit on public forms and emailed links, per minute. Keep 20 in production.
RATE_LIMIT_PER_DEVICE_PER_MINUTE=20

# Error reports (Sentry). Off while empty. Personal data is scrubbed before sending (SentryScrubber).
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Children's photos: private. "local" = storage/app/private/photos. Production (Laravel Cloud): attach a PRIVATE
# bucket (Cloud fills in AWS_*) and set PHOTOS_DISK=s3. PHOTOS_BUCKET only if photos get their own bucket.
PHOTOS_DISK=local
PHOTOS_BUCKET=
