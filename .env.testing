# Throwaway key, committed on purpose so a fresh clone can run the suite. Never reuse it anywhere real.
# Used by `--env=testing` (make migrate-check) and Pest. Points at the TEST database so the gate can never
# touch the working one: without this file `migrate:fresh --env=testing` falls back to .env and wipes dev data.
APP_NAME=NxtGen
APP_ENV=testing
APP_KEY=base64:Czve0RY8UK1EiQqxQSwl/s2Z0mbzhi2oQrydoGhsq/c=
APP_DEBUG=true
BCRYPT_ROUNDS=4
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=33316
DB_DATABASE=nxtgen_test
DB_USERNAME=nxtgen
DB_PASSWORD=nxtgen

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=null
